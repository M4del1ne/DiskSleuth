    "browser_downloads": { "name": "下载记录", "group": "浏览器", "columns": { "start": "开始时间 (UTC)", "end": "完成时间 (UTC)", "browser": "浏览器", "user": "用户", "target": "保存位置", "url": "网址", "size": "大小", "state": "状态", "source": "来源" } }
