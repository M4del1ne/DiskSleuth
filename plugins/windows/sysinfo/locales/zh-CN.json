    "Registered owner": "注册所有者", "Registered organization": "注册组织", "Install date": "安装时间",
    "Last logged-on user": "最后登录用户", "Last logged-on user (SAM)": "最后登录用户 (SAM)",
    "Last shutdown": "最后关机时间", "System root": "系统目录", "Processor architecture": "处理器架构",
    "UTC offset": "UTC 偏移", "Daylight saving disabled": "已禁用夏令时", "Yes": "是"
  }
